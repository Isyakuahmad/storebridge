DB_HOST=localhost
DB_PORT=3306
DB_NAME=catalogue
DB_USER=catalogue
DB_PASSWORD=

UPLOAD_DIR=/var/www/html/uploads
UPLOAD_URL=/uploads

# Choosery subscription payments. Set real values only in server-local config/secrets.
# Do not put bank account details in tracked files.
# CHOOSERY_BANK_NAME=
# CHOOSERY_BANK_ACCOUNT_NAME=
# CHOOSERY_BANK_ACCOUNT_NUMBER=
# Optional platform support contacts. Keep real values out of source control.
# CHOOSERY_SUPPORT_EMAIL=
# CHOOSERY_SUPPORT_WHATSAPP=2348029033160
APP_URL=https://storebridge.freedev.app

# Google OpenID Connect. Create a Web OAuth client in Google Cloud Console.
# Register this exact redirect URI in the OAuth client:
# https://storebridge.freedev.app/auth/google-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://storebridge.freedev.app/auth/google-callback.php
